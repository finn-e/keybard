# Bleeding edge: the newest prerelease (x tag) of svalboard/keybard, served at
# https://next.keybard.svalboard.com (see .github/workflows/next-deploy.yml).
# Its own storage namespace, so its saved layouts and backups are never mixed up
# with stable's.
VITE_BASE_PATH=/
VITE_STORAGE_NAMESPACE=keybard-next
VITE_CHANNEL=next
